<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.4</Version>
    <!-- Champs du manifeste affichés dans /xlplugins -->
    <Author>Powerl3ss</Author>
    <Name>MarketTip</Name>
    <!-- Exigée par DalamudPackager, puis vidée par la GitHub Action pour n'afficher que la ligne des commandes. -->
    <Description>MarketTip</Description>
    <Punchline>Les prix du marché dans l'infobulle des objets, en français.</Punchline>
    <RepoUrl>https://github.com/Powerl3ss/MarketTip</RepoUrl>
    <Tags>market;marketboard;price;universalis;tooltip;prix</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IconUrl>https://raw.githubusercontent.com/Powerl3ss/MarketTip/main/MarketTip/images/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="images\icon.png" LogicalName="MarketTip.icon.png" />
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
